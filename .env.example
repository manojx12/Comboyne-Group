# Copy to .env (or set in your host's dashboard). None of these are secrets.

# Canonical origin used for canonical URLs, Open Graph and the sitemap.
SITE_URL=https://comboynegroup.com

# Search indexing is OFF unless this is exactly "true". Set it only for the
# production deployment, never for previews.
PUBLIC_ALLOW_INDEXING=false

# Leave empty until a real quote backend exists. When set, the quote form POSTs
# multipart form data here and only shows "sent" if the endpoint returns
# HTTP 2xx with JSON {"ok": true}. See docs/INTEGRATIONS.md.
PUBLIC_QUOTE_ENDPOINT=
